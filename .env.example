# Supabase project URL and public anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (secret). Project settings > API keys in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# Login password for the /admin popup editor.
ADMIN_PASSWORD=

# Random secret used to sign the admin login session cookie.
ADMIN_SESSION_SECRET=
